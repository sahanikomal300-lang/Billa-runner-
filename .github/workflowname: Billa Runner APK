name: Billa Runner - Android APK Build

on:
  workflow_dispatch:

  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    name: Build Billa Runner APK
    runs-on: ubuntu-latest

    steps:

      # --------------------------------
      # 1. Download project
      # --------------------------------
      - name: Checkout Billa Runner
        uses: actions/checkout@v4


      # --------------------------------
      # 2. Setup Java
      # --------------------------------
      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle


      # --------------------------------
      # 3. Setup Gradle
      # --------------------------------
      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4


      # --------------------------------
      # 4. Check project files
      # --------------------------------
      - name: Show project structure
        run: |
          echo "===== PROJECT FILES ====="
          find . -maxdepth 3 -type f | sort
          echo "========================="


      # --------------------------------
      # 5. Check Android project
      # --------------------------------
      - name: Check Android module
        run: |
          echo "Checking app module..."
          test -d app
          test -f settings.gradle.kts
          test -f build.gradle.kts
          echo "Android project structure OK"


      # --------------------------------
      # 6. Build Debug APK
      # --------------------------------
      - name: Build Debug APK
        run: |
          gradle --no-daemon assembleDebug


      # --------------------------------
      # 7. Find generated APK
      # --------------------------------
      - name: Find APK
        run: |
          echo "===== GENERATED APK ====="
          find app/build/outputs/apk -type f -name "*.apk" -print
          echo "========================="


      # --------------------------------
      # 8. Rename APK
      # --------------------------------
      - name: Prepare Billa Runner APK
        run: |
          mkdir -p release
          APK=$(find app/build/outputs/apk/debug -type f -name "*.apk" | head -n 1)

          if [ -z "$APK" ]; then
            echo "ERROR: APK was not generated!"
            exit 1
          fi

          cp "$APK" release/Billa-Runner.apk

          echo "APK ready:"
          ls -lh release/Billa-Runner.apk


      # --------------------------------
      # 9. Upload APK
      # --------------------------------
      - name: Upload Billa Runner APK
        uses: actions/upload-artifact@v4
        with:
          name: Billa-Runner-APK
          path: release/Billa-Runner.apk
          if-no-files-found: error


      # --------------------------------
      # 10. Build summary
      # --------------------------------
      - name: Build Summary
        run: |
          echo "======================================"
          echo "       BILLA RUNNER BUILD SUCCESS"
          echo "======================================"
          echo "APK: Billa-Runner.apk"
          echo "Status: BUILD COMPLETED"
          echo "======================================"
